# Copy to .env in the repository root and replace the placeholders.
# Personal access token permissions: Code Connect Write and File content Read.
FIGMA_ACCESS_TOKEN=your_personal_access_token
# Key from your hosted Design System URL: /design/<file-key>/...
# Also update documentUrlSubstitutions in the Code Connect configs;
# FIGMA_FILE_KEY does not automatically rewrite their URLs.
FIGMA_FILE_KEY=your_design_system_file_key
# Key from your imported App Screens URL, saved for lab reference.
FIGMA_APP_SCREENS_FILE_KEY=your_app_screens_file_key
