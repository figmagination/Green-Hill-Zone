{
  "name": "green-hill",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace @green-hill/app-screens --",
    "build": "npm run build --workspace @green-hill/app-screens",
    "lint": "eslint .",
    "preview": "npm run preview --workspace @green-hill/app-screens --",
    "figma:parse": "figma connect parse",
    "figma:publish": "figma connect publish",
    "figma:parse:html": "figma connect parse --config figma.config.html.json",
    "figma:publish:html": "figma connect publish --config figma.config.html.json",
    "figma:publish:all": "npm run figma:publish && npm run figma:publish:html",
    "figma:unpublish": "figma connect unpublish",
    "storybook": "npm run storybook --workspace @green-hill/design-system --",
    "build-storybook": "npm run build-storybook --workspace @green-hill/design-system"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@figma/code-connect": "^2.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
