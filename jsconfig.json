{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "apps/app-screens/src/*"
      ],
      "@green-hill/design-system": [
        "packages/design-system/src/index.js"
      ],
      "@green-hill/design-system/components/*": [
        "packages/design-system/src/components/*"
      ]
    },
    "types": [
      "@figma/code-connect/figma-types"
    ],
    "checkJs": false,
    "jsx": "react-jsx"
  },
  "include": [
    "apps/**/*",
    "packages/**/*",
    "*.config.js"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/storybook-static"
  ]
}
